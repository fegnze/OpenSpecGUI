{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-state.schema.json",
  "title": "DH 浏览器资源重组 Program 状态",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "programId", "changes", "gates", "contractLocks", "contractConsumptions", "impactReviews", "blockers", "legacyMigration"],
  "properties": {
    "$schema": { "const": "contracts/program-state.schema.json" },
    "schemaVersion": { "const": 1 },
    "programId": { "const": "dh-browser-progressive-resource-reorganization" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["changeId", "status", "blockerIds"],
        "properties": {
          "changeId": { "type": "string" },
          "status": { "enum": ["planned", "ready", "active", "verification", "accepted", "rework", "blocked", "needs-review"] },
          "blockerIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "status", "evidence"],
        "properties": {
          "gateId": { "type": "string" },
          "status": { "enum": ["pending", "reviewing", "passed", "failed"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "contractLocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lockId", "producerChangeId", "revision", "paths", "sha256", "consumerChangeIds"],
        "properties": {
          "lockId": { "type": "string" },
          "producerChangeId": { "type": "string" },
          "revision": { "type": "integer", "minimum": 1 },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "consumerChangeIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "contractConsumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lockId", "changeId", "acceptedRevision"],
        "properties": {
          "lockId": { "type": "string" },
          "changeId": { "type": "string" },
          "acceptedRevision": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "impactReviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lockId", "changeId", "lockRevision", "conclusion", "evidence"],
        "properties": {
          "lockId": { "type": "string" },
          "changeId": { "type": "string" },
          "lockRevision": { "type": "integer", "minimum": 1 },
          "conclusion": { "enum": ["unaffected", "update_required", "reverify_required", "invalidated"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockerId", "changeId", "status", "description", "evidence"],
        "properties": {
          "blockerId": { "type": "string" },
          "changeId": { "type": "string" },
          "status": { "enum": ["open", "resolved"] },
          "description": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "legacyMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "disposition", "referencePolicy", "verificationEvidence"],
      "properties": {
        "status": { "enum": ["takeover", "cleanup-ready", "cleanup-complete"] },
        "disposition": { "type": "string" },
        "referencePolicy": { "type": "string" },
        "verificationEvidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
