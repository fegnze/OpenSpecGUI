{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "initiative-overview.schema.json",
  "title": "Resource Program Initiative Overview Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providerId", "initiativeId", "sourceHash", "summaryStatus", "program", "workstreams", "changes", "gates", "milestones", "contracts", "blockers", "assignments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "providerId": { "const": "wtc-resource-program-v1" },
    "initiativeId": { "$ref": "#/$defs/id" },
    "sourceHash": { "$ref": "#/$defs/sourceHash" },
    "summaryStatus": { "$ref": "#/$defs/summaryStatus" },
    "program": { "$ref": "#/$defs/program" },
    "workstreams": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/workstream" } },
    "changes": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/change" } },
    "gates": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/gate" } },
    "milestones": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/milestone" } },
    "contracts": { "$ref": "#/$defs/contracts" },
    "blockers": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/blocker" } },
    "assignments": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/assignment" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 120 },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "minLength": 1,
      "maxLength": 500
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64 },
    "idList": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "pathList": { "type": "array", "maxItems": 2000, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "textList": { "type": "array", "maxItems": 2000, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "summaryStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "value"],
      "properties": {
        "authority": { "const": "derived" },
        "value": { "enum": ["invalid", "blocked", "needs-review", "in-progress", "complete"] }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programId", "title"],
      "properties": {
        "programId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "workstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workstreamId", "name", "objective", "document"],
      "properties": {
        "workstreamId": { "type": "string", "pattern": "^ws-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "document": { "$ref": "#/$defs/path" }
      }
    },
    "taskCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "total"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "total": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archived", "blockerIds", "changeId", "kind", "resourceSourceAccess", "risk", "status", "tasks", "title", "workstreamId"],
      "properties": {
        "archived": { "type": "boolean" },
        "blockerIds": { "$ref": "#/$defs/idList" },
        "changeId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["contract", "foundation", "vertical-slice", "migration-batch", "quality", "cutover"] },
        "resourceSourceAccess": { "enum": ["none", "read", "modify"] },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "status": { "enum": ["planned", "ready", "active", "verification", "accepted", "rework", "blocked", "needs-review"] },
        "tasks": { "$ref": "#/$defs/taskCounts" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "workstreamId": { "type": "string", "pattern": "^ws-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "gateId", "requiredChanges", "requiredEvidence", "status", "title", "type"],
      "properties": {
        "evidence": { "$ref": "#/$defs/pathList" },
        "gateId": { "type": "string", "pattern": "^gate-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
        "requiredChanges": { "$ref": "#/$defs/idList" },
        "requiredEvidence": { "$ref": "#/$defs/pathList" },
        "status": { "enum": ["pending", "reviewing", "passed", "failed"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "type": { "enum": ["contract", "delivery", "milestone"] }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "milestoneId", "status", "title"],
      "properties": {
        "gateId": { "type": "string", "pattern": "^gate-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
        "milestoneId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["pending", "reviewing", "passed", "failed"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "contractLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumerChangeIds", "lockId", "paths", "producerChangeId", "revision", "sha256"],
      "properties": {
        "consumerChangeIds": { "$ref": "#/$defs/idList" },
        "lockId": { "$ref": "#/$defs/id" },
        "paths": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "producerChangeId": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "sha256": { "$ref": "#/$defs/sourceHash" }
      }
    },
    "contractConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedRevision", "changeId", "lockId"],
      "properties": {
        "acceptedRevision": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "changeId": { "$ref": "#/$defs/id" },
        "lockId": { "$ref": "#/$defs/id" }
      }
    },
    "impactReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeId", "conclusion", "evidence", "lockId", "lockRevision"],
      "properties": {
        "changeId": { "$ref": "#/$defs/id" },
        "conclusion": { "enum": ["unaffected", "update_required", "reverify_required", "invalidated"] },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "lockId": { "$ref": "#/$defs/id" },
        "lockRevision": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumptions", "impactReviews", "locks"],
      "properties": {
        "consumptions": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/contractConsumption" } },
        "impactReviews": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/impactReview" } },
        "locks": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/contractLock" } }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockerId", "changeId", "description", "evidence", "status"],
      "properties": {
        "blockerId": { "$ref": "#/$defs/id" },
        "changeId": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "status": { "enum": ["open", "resolved"] }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptanceChecks", "assignmentId", "changeId", "executorRole", "implementationEvidence", "objective", "prohibitedActions", "risk", "scope", "stage", "status", "taskIds", "verdict", "verificationEvidence", "verifierRole"],
      "properties": {
        "acceptanceChecks": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "assignmentId": { "$ref": "#/$defs/id" },
        "changeId": { "$ref": "#/$defs/id" },
        "executorRole": { "enum": ["main-agent", "execution-subagent"] },
        "implementationEvidence": { "$ref": "#/$defs/pathList" },
        "objective": { "$ref": "#/$defs/text" },
        "prohibitedActions": { "$ref": "#/$defs/textList" },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "scope": { "type": "array", "minItems": 1, "maxItems": 2000, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "stage": { "enum": ["takeover", "cleanup", "delivery"] },
        "status": { "enum": ["planned", "active", "awaiting-verification", "accepted", "rework", "blocked"] },
        "taskIds": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "maxLength": 20 } },
        "verdict": { "type": ["string", "null"], "enum": [null, "accepted", "rework"] },
        "verificationEvidence": { "$ref": "#/$defs/pathList" },
        "verifierRole": { "enum": ["none", "verification-subagent"] }
      }
    }
  }
}
