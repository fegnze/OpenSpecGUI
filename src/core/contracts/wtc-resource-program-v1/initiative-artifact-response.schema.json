{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "initiative-artifact-response.schema.json",
  "title": "Resource Program Initiative Artifact Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providerId", "initiativeId", "sourceHash", "artifactId", "mediaType", "content", "metadata"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "providerId": { "const": "wtc-resource-program-v1" },
    "initiativeId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 120 },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64 },
    "artifactId": { "type": "string", "pattern": "^artifact-[a-f0-9]{16}$", "minLength": 25, "maxLength": 25 },
    "mediaType": { "enum": ["text/markdown", "application/json", "text/plain"] },
    "content": { "type": "string", "maxLength": 2097152 },
    "metadata": { "$ref": "initiative-artifact-index.schema.json#/$defs/artifact" }
  }
}
