{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact-taxonomy.schema.json",
  "title": "DH 浏览器资源重组工程档案分类",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "programId", "topics", "annotations"],
  "properties": {
    "$schema": { "const": "contracts/artifact-taxonomy.schema.json" },
    "schemaVersion": { "const": 1 },
    "programId": { "const": "dh-browser-progressive-resource-reorganization" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topicId", "name"],
        "properties": {
          "topicId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.)[A-Za-z0-9_./-]+$" },
          "topics": { "type": "array", "items": { "type": "string" } },
          "relatedWorkstreamIds": { "type": "array", "items": { "type": "string" } },
          "relatedChangeIds": { "type": "array", "items": { "type": "string" } },
          "featured": { "type": "boolean" },
          "readingSections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heading", "role", "priority"],
              "properties": {
                "heading": { "type": "string", "minLength": 1 },
                "role": { "enum": ["conclusion", "design", "evidence"] },
                "priority": { "enum": ["primary", "supporting"] }
              }
            }
          }
        }
      }
    }
  }
}
