{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "initiative-artifact-index.schema.json",
  "title": "Resource Program Initiative Artifact Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providerId", "initiativeId", "sourceHash", "artifacts", "readingSections", "diagrams", "topics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "providerId": { "const": "wtc-resource-program-v1" },
    "initiativeId": { "$ref": "#/$defs/id" },
    "sourceHash": { "$ref": "#/$defs/sourceHash" },
    "artifacts": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/artifact" } },
    "readingSections": { "type": "array", "maxItems": 50000, "items": { "$ref": "#/$defs/readingSection" } },
    "diagrams": { "type": "array", "maxItems": 50000, "items": { "$ref": "#/$defs/diagram" } },
    "topics": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/topic" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 120 },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64 },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "minLength": 1,
      "maxLength": 500
    },
    "idList": { "type": "array", "maxItems": 2000, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "artifactId": { "type": "string", "pattern": "^artifact-[a-f0-9]{16}$", "minLength": 25, "maxLength": 25 },
    "sectionId": { "type": "string", "pattern": "^section-[a-f0-9]{16}$", "minLength": 24, "maxLength": 24 },
    "diagramId": { "type": "string", "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)+$", "minLength": 3, "maxLength": 120 },
    "relatedStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId", "entityType", "status"],
      "properties": {
        "entityId": { "$ref": "#/$defs/id" },
        "entityType": { "enum": ["assignment", "change-location", "change", "gate"] },
        "status": { "enum": ["planned", "ready", "active", "verification", "accepted", "rework", "blocked", "needs-review", "archived", "pending", "reviewing", "passed", "failed"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "assignmentIds", "authority", "changeIds", "currency", "diagramIds", "evidenceTypes", "gateIds", "kind", "lifecycle", "mediaType", "path", "readingSectionIds", "scope", "scopeId", "summary", "title", "topics", "workstreamIds"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/artifactId" },
        "assignmentIds": { "$ref": "#/$defs/idList" },
        "authority": { "enum": ["program-authority", "change-artifact", "implementation-evidence", "verification-evidence"] },
        "changeIds": { "$ref": "#/$defs/idList" },
        "currency": { "enum": ["current", "historical"] },
        "diagramIds": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/diagramId" } },
        "evidenceTypes": { "$ref": "#/$defs/idList" },
        "gateIds": { "$ref": "#/$defs/idList" },
        "kind": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 120 },
        "lifecycle": { "enum": ["baseline", "planning", "design", "implementation", "verification"] },
        "mediaType": { "enum": ["text/markdown", "application/json", "text/plain"] },
        "path": { "$ref": "#/$defs/path" },
        "readingSectionIds": { "type": "array", "maxItems": 5000, "uniqueItems": true, "items": { "$ref": "#/$defs/sectionId" } },
        "scope": { "enum": ["program", "workstream", "change"] },
        "scopeId": { "$ref": "#/$defs/id" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "topics": { "$ref": "#/$defs/idList" },
        "workstreamIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ws-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 }
        }
      }
    },
    "readingSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "artifactTitle", "assignmentIds", "authority", "changeIds", "currency", "evidenceTypes", "gateIds", "heading", "headingLevel", "lifecycle", "path", "priority", "relatedStatuses", "role", "scope", "scopeId", "sectionId", "sourceIndex", "summary", "topics", "workstreamIds"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/artifactId" },
        "artifactTitle": { "type": "string", "minLength": 1, "maxLength": 500 },
        "assignmentIds": { "$ref": "#/$defs/idList" },
        "authority": { "enum": ["program-authority", "change-artifact", "implementation-evidence", "verification-evidence"] },
        "changeIds": { "$ref": "#/$defs/idList" },
        "currency": { "enum": ["current", "historical"] },
        "evidenceTypes": { "$ref": "#/$defs/idList" },
        "gateIds": { "$ref": "#/$defs/idList" },
        "heading": { "type": "string", "minLength": 1, "maxLength": 500 },
        "headingLevel": { "type": "integer", "minimum": 1, "maximum": 6 },
        "lifecycle": { "enum": ["baseline", "planning", "design", "implementation", "verification"] },
        "path": { "$ref": "#/$defs/path" },
        "priority": { "enum": ["primary", "supporting"] },
        "relatedStatuses": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/relatedStatus" } },
        "role": { "enum": ["conclusion", "design", "evidence"] },
        "scope": { "enum": ["program", "workstream", "change"] },
        "scopeId": { "$ref": "#/$defs/id" },
        "sectionId": { "$ref": "#/$defs/sectionId" },
        "sourceIndex": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "topics": { "$ref": "#/$defs/idList" },
        "workstreamIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ws-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 }
        }
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "diagramId", "renderable", "sourceHeading", "sourceIndex", "standing", "type"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/artifactId" },
        "diagramId": { "$ref": "#/$defs/diagramId" },
        "renderable": { "type": "boolean" },
        "sourceHeading": { "type": "string", "minLength": 1, "maxLength": 500 },
        "sourceIndex": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "standing": { "enum": ["historical-change", "program-orchestration", "target-architecture"] },
        "type": { "enum": ["flowchart", "stateDiagram-v2", "sequenceDiagram", "classDiagram", "erDiagram"] }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topicId", "name", "description"],
      "properties": {
        "topicId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
